{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "src/**/*.ts",
    "client/**/*.ts",
    "demo/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
