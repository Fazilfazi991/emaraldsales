{
  "name": "emerald-field-sales-crm",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "staging:migrate": "tsx scripts/staging-migrate.ts",
    "staging:seed": "tsx scripts/staging-seed.ts",
    "db:seed": "tsx scripts/seed.ts",
    "account:create": "tsx scripts/account.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:postgres": "tsx --test tests/postgres.integration.ts",
    "test:browser": "node scripts/build.mjs && tsx scripts/phase2-browser.ts",
    "test:reference": "node scripts/baseline.mjs",
    "test:integrity": "node scripts/integrity.mjs",
    "test:runtime": "node scripts/phase2-runtime.mjs",
    "review:downloads": "tsx scripts/review-downloads.ts",
    "pdf:setup": "playwright install chromium",
    "demo:prepare": "tsx scripts/phase3-demo.ts",
    "demo:start": "tsx scripts/phase3-demo-start.ts",
    "test:browser:phase3": "node scripts/build.mjs && tsx scripts/phase3-browser.ts",
    "test:runtime:phase3": "tsx scripts/phase3-runtime.ts",
    "review:reports:phase3": "tsx scripts/phase3-report-samples.ts",
    "test:navigation": "node scripts/build.mjs && tsx scripts/verify-navigation.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@sparticuz/chromium": "153.0.0",
    "@vercel/functions": "3.10.1",
    "exceljs": "4.4.0",
    "fontkit": "2.0.4",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "playwright-core": "1.63.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
